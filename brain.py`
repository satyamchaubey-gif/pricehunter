import requests
import json

OLLAMA_URL = "http://localhost:11434/api/generate"
MODEL_NAME = "hermes"

def get_best_deal(product_name, search_results):
    """
    Sends search results to Hermes AI to determine the best deal.
    """
    # Prepare the results for the AI to read
    results_text = ""
    for i, res in enumerate(search_results):
        results_text += f"ID {i}: {res['title']} | Price: {res['price_display']} | Source: {res['source']} | URL: {res['url']}\n"

    prompt = f"""
    You are the PriceHunter AI Brain. Your goal is to find the absolute best deal for the user.

    Product requested: {product_name}

    Available Results:
    {results_text}

    Analyze the results and pick the best one. The "best" is usually the cheapest, but consider if the title looks like a scam or a different product.

    You MUST respond ONLY in the following JSON format:
    {{
        "best_index": <index_number>,
        "reasoning": "<one short sentence explaining why this is the best deal>",
        "final_price": "<the price string>"
    }}
    """

    try:
        response = requests.post(OLLAMA_URL, json={
            "model": MODEL_NAME,
            "prompt": prompt,
            "stream": False,
            "format": "json"
        })

        if response.status_code == 200:
            return json.loads(response.json()['response'])
        else:
            return None
    except Exception as e:
        print(f"AI Brain Error: {e}")
        return None
